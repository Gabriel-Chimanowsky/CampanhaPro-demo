APP_NAME=GTFlow
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://gtflowv3.test

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

AI_DEFAULT_PROVIDER=openai
AI_TIMEOUT=60
AI_OUTPUT_DISK=public
AI_OUTPUT_PATH=ai-generations

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT=60
OPENAI_TEXT_MODEL=gpt-5-mini
OPENAI_TEXT_MODEL_ALT=gpt-4.1-mini
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_IMAGE_SIZE=1536x1024
OPENAI_IMAGE_QUALITY=medium
OPENAI_IMAGE_BACKGROUND=opaque
OPENAI_IMAGE_OUTPUT_FORMAT=png

GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/
GEMINI_TIMEOUT=60
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_TEXT_MODEL_FAST=gemini-2.5-flash-lite
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

BRAND_DNA_TRANSCRIPTION_PROVIDER=gemini
BRAND_DNA_TRANSCRIPTION_MODEL=gemini-2.5-flash
BRAND_DNA_MAX_MP4_MB=200
BRAND_DNA_TEMP_DISK=local
BRAND_DNA_DELETE_PROVIDER_FILES=true
BRAND_DNA_INGESTION_TIMEOUT=300
BRAND_DNA_EMBEDDINGS_ENABLED=true
BRAND_DNA_EMBEDDINGS_PROVIDER=gemini
BRAND_DNA_EMBEDDINGS_MODEL=gemini-embedding-001
BRAND_DNA_EMBEDDINGS_DIMENSIONS=1536
BRAND_DNA_EMBEDDINGS_TIMEOUT=120
BRAND_DNA_PGVECTOR_ENABLED=true
BRAND_DNA_HYBRID_CANDIDATE_LIMIT=12
BRAND_DNA_HYBRID_RRF_K=60
BRAND_DNA_HYBRID_MMR_LAMBDA=0.72
CHAT_HISTORY_MAX_MESSAGES=8
CHAT_HISTORY_SUMMARY_MAX_CHARS=900
CHAT_STREAM_CHUNK_SIZE=32
CHAT_STREAM_CHUNK_SLEEP_US=12000
BRAND_DNA_CHUNK_SIZE=1100
BRAND_DNA_CHUNK_OVERLAP=180
BRAND_DNA_RETRIEVAL_LIMIT=4

OPENROUTER_API_ENDPOINT=https://openrouter.ai/api/v1/
OPENROUTER_API_KEY=
OPENROUTER_API_TIMEOUT=60
OPENROUTER_API_TITLE=
OPENROUTER_API_REFERER=
OPENROUTER_TEXT_MODEL=openai/gpt-4.1-mini
OPENROUTER_TEXT_MODEL_ALT=google/gemini-2.5-flash
OPENROUTER_TEXT_MODEL_ALT_2=anthropic/claude-sonnet-4.5
OPENROUTER_FREE_MODEL=google/gemma-3-27b-it:free
OPENROUTER_FREE_MODEL_ALT=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_ALLOW_FALLBACKS=true
OPENROUTER_REQUIRE_PARAMETERS=true
OPENROUTER_DATA_COLLECTION=deny
OPENROUTER_ZDR=false
OPENROUTER_PROVIDER_ORDER=
OPENROUTER_ROUTE=

VITE_APP_NAME="${APP_NAME}"
